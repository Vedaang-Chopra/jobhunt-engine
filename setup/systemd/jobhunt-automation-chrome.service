[Unit]
Description=Job-hunt automation Chrome (CDP :9333, profile ~/.hermes/browser-profiles/job-hunt)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=%h/git/jobhunt-engine/scripts/automation_chrome.sh
# The script is idempotent; a restart just re-checks CDP and exits.
ExecStop=-/bin/pkill -f 'user-data-dir=%h/.hermes/browser-profiles/job-hunt'
TimeoutStartSec=60

[Install]
WantedBy=graphical-session.target
